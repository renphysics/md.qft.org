---
import Icon from '../components/Icon.astro';
import { siteConfig } from '../config/site';
import { withBase } from '../lib/site-path';
import '@fontsource-variable/inter';
import '@fontsource-variable/lora';
import '@fontsource/jetbrains-mono/400.css';
import '../styles/app.css';
interface Props { title?: string; description?: string; active?: string; workspace?: boolean }
const { title = `${siteConfig.name} — ${siteConfig.tagline}`, description = siteConfig.description, active = 'editor', workspace = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Pages cannot set custom response headers. Deliver the supported CSP
// directives before any resource loads. Vite's development server needs HMR.
const contentSecurityPolicy = [
  "default-src 'self'",
  "script-src 'self'",
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data: blob: https:",
  "font-src 'self' data:",
  `connect-src 'self' https: blob:${import.meta.env.DEV ? ' ws: wss:' : ''}`,
  "worker-src 'self' blob:",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'none'",
].join('; ');
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="Content-Security-Policy" content={contentSecurityPolicy} />
    <meta name="referrer" content="no-referrer" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f6f2" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <title>{title}</title>
  </head>
  <body class:list={{ 'workspace-page': workspace }}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <a href={withBase()} class="brand" aria-label={`${siteConfig.name} home`}>
        <span class="brand-symbol" aria-hidden="true">m<span>∗</span></span>
        <span class="brand-wordmark"><strong>{siteConfig.name}</strong><span class="brand-caption">{siteConfig.tagline}</span></span>
      </a>
      <nav class="top-nav" aria-label="Main navigation">
        <a href={withBase()} class:list={{ active: active === 'editor' }} aria-current={active === 'editor' ? 'page' : undefined}>Workspace</a>
        <a href={withBase('guide/')} class:list={{ active: active === 'guide' }} aria-current={active === 'guide' ? 'page' : undefined}>Guide</a>
        <a href={withBase('examples/')} class:list={{ active: active === 'examples' }} aria-current={active === 'examples' ? 'page' : undefined}>Examples</a>
      </nav>
      <div class="header-actions">
        <span class="local-badge"><span></span> Made for focus</span>
        <a href={withBase('about/')} class="about-link">About</a>
        <span class="header-divider"></span>
        <button class="icon-button theme-button" data-theme-toggle aria-label="Switch to dark theme" title="Switch theme"><Icon name="moon" class="moon-icon" /><Icon name="sun" class="sun-icon" /></button>
      </div>
    </header>
    <slot />
    <script>
      import '../scripts/global';
    </script>
  </body>
</html>
