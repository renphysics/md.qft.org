---
import Icon from '../components/Icon.astro';
import WorkspaceExports from '../components/WorkspaceExports.astro';
import { siteConfig } from '../config/site';
import { withBase } from '../lib/site-path';
import { serializeJsonLd, structuredData } from '../lib/site-seo';
import type { SiteFaq } from '../lib/site-faq';
import '@fontsource-variable/inter';
import '@fontsource-variable/lora';
import '@fontsource/jetbrains-mono/400.css';
import '../styles/app.css';
interface Props { title?: string; description?: string; active?: string; workspace?: boolean; noindex?: boolean; faq?: readonly SiteFaq[] }
const { title = `${siteConfig.name} — ${siteConfig.title}`, description = siteConfig.description, active = 'editor', workspace = false, noindex = false, faq } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const home = new URL(withBase(), Astro.site);
const socialImage = new URL(withBase('social-card.png'), Astro.site);
const jsonLd = serializeJsonLd(structuredData({ homeUrl: home.href, canonicalUrl: canonical.href, title, description, faq }));
// Pages cannot set custom response headers. Deliver the supported CSP
// directives before any resource loads. Vite's development server needs HMR.
const contentSecurityPolicy = [
  "default-src 'self'",
  "script-src 'self'",
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data: blob: https:",
  "font-src 'self' data:",
  `connect-src 'self' https: blob:${import.meta.env.DEV ? ' ws: wss:' : ''}`,
  "worker-src 'self' blob:",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'none'",
].join('; ');
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="Content-Security-Policy" content={contentSecurityPolicy} />
    <meta name="referrer" content="no-referrer" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content="#f8f6f2" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${siteConfig.name}: Markdown, mathematics, and documents ready to share`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={`${siteConfig.name}: Markdown, mathematics, and documents ready to share`} />
    {!noindex && <script is:inline type="application/ld+json" set:html={jsonLd} />}
    <title>{title}</title>
  </head>
  <body class:list={{ 'workspace-page': workspace }}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <a href={withBase()} class="brand" aria-label={`${siteConfig.name} home`}>
        <span class="brand-symbol" aria-hidden="true">m<span>∗</span></span>
        <span class="brand-wordmark"><strong>{siteConfig.name}</strong></span>
      </a>
      <nav class="top-nav" aria-label="Main navigation">
        <a href={withBase()} class:list={{ active: active === 'editor' }} aria-current={active === 'editor' ? 'page' : undefined}>Workspace</a>
        <a href={withBase('guide/')} class:list={{ active: active === 'guide' }} aria-current={active === 'guide' ? 'page' : undefined}>Guide</a>
        <a href={withBase('examples/')} class:list={{ active: active === 'examples' }} aria-current={active === 'examples' ? 'page' : undefined}>Examples</a>
      </nav>
      <div class="header-actions">
        <span class="local-badge"><span></span> Made for focus</span>
        <a href={withBase('about/')} class="about-link">About</a>
        <span class="header-divider"></span>
        <button class="icon-button theme-button" data-theme-toggle aria-label="Switch to dark theme" title="Switch theme"><Icon name="moon" class="moon-icon" /><Icon name="sun" class="sun-icon" /></button>
        {workspace && <WorkspaceExports />}
      </div>
    </header>
    <slot />
    <script>
      import '../scripts/global';
    </script>
  </body>
</html>
