---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { EXAMPLES } from '../lib/examples';
import SiteFooter from '../components/SiteFooter.astro';
import { siteConfig } from '../config/site';
import { withBase } from '../lib/site-path';
---
<BaseLayout title={`Examples — ${siteConfig.name}`} active="examples" description="Explore study notes, a project report, mathematical derivations, and a Markdown field guide. Open an example, organize it, and try a PDF style.">
  <main id="main-content" class="content-page">
    <span class="page-kicker">A starting point for your next document</span>
    <h1>Good ideas take many forms.</h1>
    <p class="page-lead">A study guide, a useful update, a careful calculation. Open an example, arrange its sections, and try a document style in Save PDF. Each opens as a draft you can make your own.</p>
    <div class="example-grid">
      {EXAMPLES.map((example, index) => (
        <article class="example-card">
          <span class="example-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <h2>{example.title}</h2>
          <p>{example.description}</p>
          <a class="button-secondary" href={withBase(`?example=${encodeURIComponent(example.id)}`)} aria-label={`Open ${example.title}`}>Open example <Icon name="arrow" size={16} /></a>
        </article>
      ))}
    </div>
    <section class="about-callout">
      <h2>Bring an idea of your own</h2>
      <p>Paste an AI answer or your own notes into the workspace. Choose a new document or append to the one you are working on. Your drafts stay in this browser; download Markdown to keep an editable copy, or save a styled HTML document or PDF to share.</p>
      <a href={withBase('guide/')}>Explore the writing guide →</a>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
