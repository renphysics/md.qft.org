---
import Icon from './Icon.astro';
import { withBase } from '../lib/site-path';
import '../styles/presentations.css';
---
<qft-presentation-library data-sandbox-url={withBase('presentation-sandbox.html')} data-example-url={withBase('slidev/interactive-physics.zip')}>
  <dialog class="app-dialog presentation-dialog" data-pres-dialog aria-labelledby="presentation-dialog-title">
    <header class="presentation-topbar">
      <button class="icon-button" data-pres-back aria-label="All presentations" title="All presentations" hidden><Icon name="previous" size={18} /></button>
      <span class="presentation-mark" aria-hidden="true"><Icon name="play" size={18} /></span>
      <div class="presentation-heading"><h2 id="presentation-dialog-title" data-pres-title>Presentations</h2><p data-pres-subtitle>Interactive slides, played in this browser.</p></div>
      <button class="icon-button" data-pres-close aria-label="Close presentations" title="Close"><Icon name="close" size={19} /></button>
    </header>
    <p class="presentation-notice" data-pres-notice role="status" aria-live="polite" hidden></p>
    <section class="presentation-library" data-pres-library aria-label="Presentation library">
      <div class="presentation-welcome">
        <div>
          <span class="eyebrow">A LITTLE MORE INTERACTION</span>
          <h3>Let your audience<br />explore the idea.</h3>
          <p>Open a Reveal.js deck or web page from your AI assistant, as an HTML file or a ZIP, or a prepared Slidev package. It plays here with its slides, sliders, and demonstrations, and your files stay in this browser.</p>
          <div class="presentation-welcome-actions"><button class="button-primary" data-pres-open><Icon name="upload" size={16} /> Open presentation <span class="sr-only">(HTML or ZIP file)</span></button><a href={withBase('guide/#slidev')}>How it works <Icon name="arrow" size={15} /></a></div>
        </div>
        <button class="presentation-example" data-pres-example aria-label="Try the interactive Slidev physics example">
          <svg viewBox="0 0 360 120" aria-hidden="true"><defs><linearGradient id="presentation-wave-color"><stop stop-color="#d8a5ae" /><stop offset="1" stop-color="#b9d2c1" /></linearGradient></defs><path d="M0 60H360M180 0V120" fill="none" stroke="#ffffff20" /><path d="M0 60C20 60 20 25 40 25S60 95 80 95S100 10 120 10S140 110 160 110S180 10 200 10S220 95 240 95S260 25 280 25S300 60 320 60S340 70 360 70" fill="none" stroke="url(#presentation-wave-color)" stroke-width="2.5" /><path d="M0 60C60 60 100 5 180 5S280 60 360 60M0 60C60 60 100 115 180 115S280 60 360 60" fill="none" stroke="#ffffff25" stroke-dasharray="3 5" /></svg>
          <span class="presentation-example-caption"><span><strong>Quantum interference</strong><small>A real Slidev deck with a live demo</small></span><span class="presentation-example-play"><Icon name="play" size={18} /></span></span>
        </button>
      </div>
      <div class="presentation-library-heading"><h3>Saved in this browser <span data-pres-count>0</span></h3><a href={withBase('slidev/interactive-physics.zip')} download>Slidev starter ZIP <Icon name="download" size={14} /></a></div>
      <div class="presentation-saved-list" data-pres-list role="list"><p class="presentation-empty">Your imported presentations will appear here.</p></div>
      <p class="presentation-library-note">For Markdown slides you edit here, use <strong>Slides</strong> in the workspace. This library plays Reveal.js decks, other HTML pages, and prepared Slidev packages as they are.</p>
    </section>
    <section class="presentation-deck" data-pres-deck hidden aria-label="Imported presentation">
      <div class="presentation-toolbar">
        <div class="presentation-view-switch" role="group" aria-label="Presentation view"><button data-pres-view="preview" aria-pressed="true"><Icon name="play" size={14} /> Presentation</button><button data-pres-view="source" aria-pressed="false"><Icon name="code" size={14} /> Source files</button></div>
        <div class="presentation-deck-actions"><button class="button-secondary" data-pres-zip-original title="Download the original file, as imported" hidden><Icon name="download" size={15} /><span>Original</span></button><button class="button-secondary" data-pres-zip title="Download the original files as a ZIP"><Icon name="download" size={15} /><span>ZIP</span></button><button class="button-secondary" data-pres-html title="Download a standalone offline player"><Icon name="code" size={15} /><span>HTML</span></button><button class="button-primary" data-pres-present><Icon name="play" size={15} /> Present</button></div>
      </div>
      <div class="presentation-preview" data-pres-preview>
        <div class="presentation-stage" data-pres-stage>
          <div class="presentation-frame-host" data-pres-host></div>
          <div class="presentation-start" data-pres-start>
            <span class="presentation-engine" data-pres-engine>Slidev</span><h3 data-pres-start-title>Your presentation is ready.</h3>
            <p data-pres-start-message>Slides and demonstrations run locally when you press Start.</p>
            <div class="presentation-problem" data-pres-problem role="alert" hidden></div>
            <button class="button-primary" data-pres-start-button><Icon name="play" size={17} /> Start presentation</button>
            <p class="presentation-start-detail" data-pres-start-detail></p>
          </div>
          <button class="presentation-exit-fullscreen" data-pres-exit-fullscreen hidden><Icon name="close" size={16} /> Exit fullscreen</button>
        </div>
        <div class="presentation-player-bar"><span class="presentation-player-status" data-pres-player-status role="status">Ready to start</span><div><span class="presentation-slide-count" data-pres-slides hidden></span><button data-pres-stop hidden>Stop</button><button data-pres-restart hidden><Icon name="refresh" size={13} /> Restart</button><span class="presentation-keyboard-hint" data-pres-keyboard-hint>Use the slide controls or arrow keys</span></div></div>
        <details class="presentation-notes" data-pres-notes hidden>
          <summary><span>Notes from the check</span> <span class="presentation-notes-count" data-pres-notes-count aria-live="polite"></span><Icon name="down" size={14} /></summary>
          <div class="presentation-notes-body">
            <ul class="presentation-notes-list" data-pres-notes-list></ul>
            <div class="presentation-runtime" data-pres-runtime hidden><p class="presentation-notes-label">While playing</p><ul class="presentation-notes-list" data-pres-runtime-list></ul></div>
            <div class="presentation-notes-actions"><button class="button-secondary" data-pres-report><Icon name="copy" size={14} /> Copy report for AI</button><span>Paste the report into the AI assistant that made the presentation.</span></div>
            <textarea class="presentation-report-text" data-pres-report-text readonly hidden spellcheck="false" aria-label="Report for your AI assistant"></textarea>
          </div>
        </details>
      </div>
      <div class="presentation-source" data-pres-source hidden>
        <nav class="presentation-files" data-pres-files aria-label="Presentation files"></nav>
        <div class="presentation-source-main">
          <div class="presentation-source-heading">
            <div class="presentation-file-title"><h3 data-pres-file-name>Files</h3><p data-pres-file-info></p></div>
            <div class="presentation-source-actions"><button class="button-secondary" data-pres-copy><Icon name="copy" size={14} /> Copy</button><button class="button-secondary" data-pres-discard hidden>Discard changes to this file</button><button class="button-primary" data-pres-apply aria-keyshortcuts="Control+S Meta+S" hidden><Icon name="check" size={14} /> Apply changes</button></div>
          </div>
          <div class="presentation-code" data-pres-code hidden></div>
          <p class="presentation-file-message" data-pres-file-message>Opening the files…</p>
          <div class="presentation-edit-problem" data-pres-edit-problem role="alert" hidden></div>
          <div class="presentation-source-footer"><p class="presentation-edit-status" data-pres-edit-status role="status" aria-live="polite"></p><button class="button-secondary" data-pres-restore aria-label="Restore original presentation" hidden><Icon name="refresh" size={14} /> Restore original</button></div>
          <p class="presentation-source-note" data-pres-source-note></p>
        </div>
      </div>
    </section>
    <footer class="presentation-dialog-footer"><span><span class="presentation-local-dot" aria-hidden="true"></span><span data-pres-storage>Not uploaded. Presentations cannot read your documents, and ordinary network requests are blocked.</span></span><a href={withBase('guide/#slidev')}>Presentation guide <Icon name="external" size={12} /></a></footer>
  </dialog>
  <dialog class="app-dialog presentation-confirm" data-pres-confirm aria-labelledby="presentation-confirm-title" aria-describedby="presentation-confirm-message">
    <form method="dialog">
      <div class="dialog-heading"><span class="eyebrow">YOUR CHANGES</span></div>
      <h2 id="presentation-confirm-title" data-pres-confirm-title>Discard your changes?</h2>
      <p id="presentation-confirm-message" data-pres-confirm-message></p>
      <div class="dialog-actions"><button class="button-secondary" value="cancel" data-pres-confirm-cancel autofocus>Keep editing</button><button class="button-primary" value="confirm" data-pres-confirm-accept>Discard changes</button></div>
    </form>
  </dialog>
  <input type="file" data-pres-input accept=".zip,.html,.htm,application/zip,text/html" hidden />
</qft-presentation-library>
<script>
  import '../scripts/presentation-library';
</script>
