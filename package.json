{
  "name": "qft-markdown",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A private, browser-based workspace for Markdown and mathematics.",
  "license": "MIT",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "test": "node --import tsx --test --test-isolation=none tests/*.test.ts",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/lora": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@mdit/plugin-footnote": "1.1.3",
    "@mdit/plugin-katex": "1.1.4",
    "@mdit/plugin-tasklist": "1.1.4",
    "astro": "7.4.4",
    "codemirror": "6.0.2",
    "highlight.js": "11.12.0",
    "katex": "0.19.1",
    "markdown-it": "15.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/katex": "0.16.8",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.19.2",
    "fake-indexeddb": "6.2.6",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "wrangler": "4.155.0"
  },
  "packageManager": "npm@11.9.0"
}
